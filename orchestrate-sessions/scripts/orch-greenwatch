#!/bin/bash
# orch-greenwatch: exits with "GREEN #n" when a ready PR has every GATE_CHECK passing
# (MUST_RUN checks really run), or "RED #n: ..." when one fails. Polls every POLL_SECONDS
# for up to 3 hours. SKIP="n n": PRs to ignore (held for a combo check or a known red).
# Run it with run_in_background and restart it after each result.
. "$(dirname "$0")/orch-lib.sh"
end=$(( $(date +%s) + 3*3600 ))
while [ "$(date +%s)" -lt "$end" ]; do
  out=$(gh api "repos/$REPO/pulls?state=open&per_page=100" --jq '.[]|select(.draft==false)|"\(.number) \(.head.sha)"' | while read -r n sha; do
    case " ${SKIP:-} " in *" $n "*) continue;; esac
    s=$(checks_of "$sha" "$GATE_CHECKS $OPTIONAL_CHECKS" 2>/dev/null)
    case " $s " in *=failure*|*=cancelled*|*=timed_out*) echo "RED #$n: $s"; continue;; esac
    ok=1
    for c in $GATE_CHECKS; do case " $s " in *" $c=success "*|*" $c=skipped "*|*" $c=neutral "*) ;; *) ok=0;; esac; done
    for c in $MUST_RUN_CHECKS; do case " $s " in *" $c=success "*) ;; *) ok=0;; esac; done
    # An optional check still running holds the merge too (mergecheck would refuse it).
    echo "$s" | tr " " "\n" | grep -qvE "=(success|skipped|neutral)$" && ok=0
    [ $ok = 1 ] && echo "GREEN #$n"
  done)
  [ -n "$out" ] && { echo "$out"; exit 0; }
  sleep "$POLL_SECONDS"
done
echo "no change in 3h"
