#!/bin/bash
# orch-cardmove <pr> [option-id]: after a merge, wait for the board's own automation to
# move the card, then set the status option (default BOARD_REVIEW_OPTION) and read it back.
. "$(dirname "$0")/orch-lib.sh"
n=$1; opt=${2:-$BOARD_REVIEW_OPTION}
[ -n "$BOARD_NUMBER" ] || { echo "no board configured"; exit 1; }
sleep 60   # the board's "merged -> Done" workflow would otherwise overwrite the move
list() { gh project item-list "$BOARD_NUMBER" --owner "$BOARD_OWNER" --format json --limit 1000 --jq "$1"; }
id=$(list ".items[]|select(.content.number==$n and .content.repository==\"$REPO\")|.id")
[ -n "$id" ] || id=$(gh project item-add "$BOARD_NUMBER" --owner "$BOARD_OWNER" --url "https://github.com/$REPO/pull/$n" --format json --jq .id)
[ -n "$id" ] || { echo "#$n no card"; exit 1; }
sleep 30
gh project item-edit --project-id "$BOARD_ID" --id "$id" --field-id "$BOARD_STATUS_FIELD" --single-select-option-id "$opt" --format json --jq .id >/dev/null
# The item list lags the edit, and the board's own automation can still move the card:
# read it back until a status shows, and say so when none does.
for _ in 1 2 3 4; do
  sleep 20
  st=$(list ".items[]|select(.id==\"$id\")|.status // empty")
  [ -n "$st" ] && { echo "#$n $st"; exit 0; }
done
echo "#$n status unreadable; check the card"; exit 1
