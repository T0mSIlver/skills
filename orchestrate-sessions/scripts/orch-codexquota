#!/usr/bin/env python3
"""orch-codexquota [--spend]: read the Codex account's rate limits through `codex app-server`.
Prints '<5h-used-%> <weekly-used-%> <5h-resets-at-epoch> <reset-credits>' (orch-queue's QUOTA_CMD).
--spend consumes the reset credit that expires first and prints the outcome:
reset | nothingToReset | noCredit | alreadyRedeemed."""
import json, subprocess, sys, uuid

p = subprocess.Popen(["codex", "app-server"], stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                     stderr=subprocess.DEVNULL, text=True, bufsize=1)
def send(msg):
    p.stdin.write(json.dumps(msg) + "\n"); p.stdin.flush()
def wait(i):
    for line in p.stdout:
        try:
            m = json.loads(line)
        except ValueError:
            continue
        if m.get("id") == i:
            return m
    sys.exit("app-server closed")
send({"id": 1, "method": "initialize", "params": {"clientInfo": {"name": "orch-codexquota", "version": "1"}}})
wait(1)
send({"method": "initialized"})
send({"id": 2, "method": "account/rateLimits/read"})
limits = wait(2).get("result") or {}
if "--spend" not in sys.argv:
    p.terminate()
    rl = limits.get("rateLimits", {})
    pr, se = rl.get("primary", {}), rl.get("secondary", {})
    n = (limits.get("rateLimitResetCredits") or {}).get("availableCount")
    print(pr.get("usedPercent"), se.get("usedPercent"), pr.get("resetsAt"), n)
    sys.exit(0)
credits = [c for c in (limits.get("rateLimitResetCredits") or {}).get("credits") or []
           if c.get("status") == "available"]
if not credits:
    p.terminate(); print("noCredit"); sys.exit(0)
soonest = min(credits, key=lambda c: c.get("expiresAt") or 0)["id"]
send({"id": 3, "method": "account/rateLimitResetCredit/consume",
      "params": {"creditId": soonest, "idempotencyKey": str(uuid.uuid4())}})
r = wait(3)
p.terminate()
if "error" in r:
    sys.exit(f"error: {r['error']}")
print(r["result"]["outcome"])
