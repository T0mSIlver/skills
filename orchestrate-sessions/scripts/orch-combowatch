#!/bin/bash
# orch-combowatch <combo-pr-number>: wait until every COMBO_CHECK finished on the combo PR's
# head; print them. Takes the number orch-combo printed (its URL or combo/<branch> also work).
# Exit 0 when all passed, 2 when one failed or 80 minutes passed, 1 when the PR isn't found.
. "$(dirname "$0")/orch-lib.sh"
n=${1:?usage: orch-combowatch <combo-pr-number>}
n=${n##*/pull/}; n=${n#\#}
case "$n" in
  *[!0-9]*) b=$1
    n=$(gh api "repos/$REPO/pulls?state=open&head=${REPO%%/*}:$b" --jq '.[0].number // empty')
    [ -n "$n" ] || { echo "no open PR for branch $b; pass the combo PR number"; exit 1; } ;;
esac
for _ in $(seq 1 40); do
  sha=$(gh api "repos/$REPO/pulls/$n" --jq .head.sha) || { echo "#$n not found"; exit 1; }
  s=$(checks_of "$sha" "$COMBO_CHECKS")
  done=1
  for c in $COMBO_CHECKS; do case " $s " in *" $c="*) ;; *) done=0;; esac; done
  echo "$s" | grep -qE "=(queued|in_progress|pending|waiting|requested)" && done=0
  if [ $done = 1 ]; then
    echo "#$n $s"
    echo "$s" | tr " " "\n" | grep -vqE "=success$" && exit 2 || exit 0
  fi
  sleep 120
done
echo "#$n timeout"; exit 2
