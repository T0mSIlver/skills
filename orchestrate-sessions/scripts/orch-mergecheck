#!/bin/bash
# orch-mergecheck <pr> [--merge]
# Before merging a ready PR: gate checks green (latest run of each), MUST_RUN checks
# really ran, no waits label, merges cleanly, and no CODE_PATHS overlap with commits
# that landed on BASE after (LAG_MINUTES before) its CI run. With COMBO=<branch> after a
# green orch-combo, the combo's first parent replaces the run time.
# --merge retargets PRs stacked on it to BASE (clearing STACK_LABEL), merges the checked
# head only (the API refuses if the PR moved) with a squash message that credits no AI
# (title, then each commit, trailers like Co-Authored-By: Claude dropped), and deletes
# the branch. A layer of a native gh stack merges through `gh stack merge`, only once
# every layer below it has merged; that call can't set the message, so a layer whose
# commits carry an AI trailer is refused until they are reworded.
# Merges stop while ~/.local/state/orchestrate/<repo name>.paused exists (its text says why).
# Exit: 0 ok/merged, 1 fetch, 2 not green, 3 waits label, 4 conflict, 5 overlap,
# 6 merge failed or refused, 7 paused.
. "$(dirname "$0")/orch-lib.sh"
n=$1; doit=${2:-}
git fetch -q origin "$BASE" "+pull/$n/head:pr$n" || exit 1
sha=$(git rev-parse "pr$n")
checks=$(checks_of "$sha" "$GATE_CHECKS $OPTIONAL_CHECKS")
labels=$(gh api "repos/$REPO/pulls/$n" --jq '[.labels[].name]|join(",")')
echo "#$n $checks labels=[$labels]"
for c in $MUST_RUN_CHECKS; do
  case " $checks " in *" $c=success "*) ;; *) echo "$c NOT PASSED (a skip does not count)"; exit 2;; esac
done
for c in $GATE_CHECKS; do case " $checks " in *" $c="*) ;; *) echo "$c MISSING"; exit 2;; esac; done
bad=$(echo "$checks" | tr " " "\n" | grep -vE "=(success|skipped|neutral)$" | grep -c .)
[ "$bad" = 0 ] || { echo "NOT GREEN"; exit 2; }
case ",$labels," in *",$WAITS_PREFIX"*) echo "HAS WAITS LABEL"; exit 3;; esac
git merge-tree --write-tree "origin/$BASE" "pr$n" >/dev/null || { echo "CONFLICT with $BASE"; exit 4; }
mine=$(git diff --name-only "$(git merge-base "origin/$BASE" "pr$n")" "pr$n" | sort -u)
if [ -n "${COMBO:-}" ]; then
  git fetch -q origin "+refs/heads/$COMBO:combo$n" || exit 1
  [ "$(git rev-parse "combo$n^2")" = "$sha" ] || { echo "COMBO tested another head"; exit 2; }
  cs=$(checks_of "$(git rev-parse "combo$n")" "$COMBO_CHECKS")
  for c in $COMBO_CHECKS; do case " $cs " in *" $c=success "*) ;; *) echo "COMBO not green: $cs"; exit 2;; esac; done
  since=$(git log -1 --format=%cI "combo$n^1"); echo "combo ok on $(git rev-parse --short "combo$n^1")"
  landed=$(git diff --name-only "combo$n^1" "origin/$BASE" | sort -u)
else
  created=$(gh api "repos/$REPO/actions/runs?head_sha=$sha&per_page=30" --jq "[.workflow_runs[]|select(.name==\"$CI_WORKFLOW_NAME\")|.created_at]|max")
  [ -n "$created" ] && [ "$created" != null ] || { echo "no $CI_WORKFLOW_NAME run for ${sha:0:8}"; exit 2; }
  # The PR's merge ref can lag BASE, so a commit that landed just before the run may be untested.
  since=$(date -u -d "$created - $LAG_MINUTES minutes" +%Y-%m-%dT%H:%M:%SZ) || exit 2
  landed=$(for c in $(git log --format=%h "origin/$BASE" ^"pr$n" --since="$since"); do git diff --name-only "$c~1" "$c"; done | sort -u)
fi
overlap=$(comm -12 <(echo "$mine") <(echo "$landed"))
echo "since=$since landed: $(git log --format=%h "origin/$BASE" ^"pr$n" --since="$since" | tr '\n' ' ')"
echo "overlap: ${overlap:-none}"
code=$(echo "$overlap" | grep -E "$CODE_PATHS" || true)
[ -z "$code" ] || { echo "CODE OVERLAP: run orch-combo $n"; exit 5; }
[ "$doit" = --merge ] || { echo "OK to merge"; exit 0; }
pause=~/.local/state/orchestrate/${REPO##*/}.paused
[ -e "$pause" ] && { echo "MERGES PAUSED: $(cat "$pause")"; exit 7; }
AI_TRAILER='^(co-authored-by:.*(claude|anthropic|codex|openai|chatgpt|copilot|glm|z\.ai)|claude-session:|.*generated (with|by) .*(claude|codex|copilot))'
B=$(gh api "repos/$REPO/pulls/$n" --jq .head.ref)
range="$(git merge-base "origin/$BASE" "pr$n")..pr$n"
stack=$(gh api "repos/$REPO/pulls/$n" --jq '.stack.number // empty')
if [ -n "$stack" ]; then
  # .stack.position keeps its old value after the layers below merge, so read the
  # stack's PRs (bottom first) and refuse only while one below #n is unmerged:
  # gh stack merge would merge it too, unchecked.
  below=$(gh api "repos/$REPO/stacks/$stack" --jq "[.pull_requests[].number] as \$p | (\$p | index($n)) as \$i
    | if \$i == null then \"missing\" else [.pull_requests[:\$i][] | select(.merged_at == null) | \"#\\(.number)\"] | join(\" \") end") || exit 1
  [ "$below" != missing ] || { echo "#$n is not in stack $stack"; exit 6; }
  [ -z "$below" ] || { echo "#$n sits above unmerged $below in stack $stack: merge those first"; exit 6; }
  bad=$(git log --format=%B "$range" | grep -ciE "$AI_TRAILER")
  [ "$bad" = 0 ] || { echo "#$n has $bad AI trailer line(s) and gh stack merge keeps them: reword the commits first"; exit 6; }
  # gh stack merge takes no sha: refuse if the PR moved since the checks above.
  [ "$(gh api "repos/$REPO/pulls/$n" --jq .head.sha)" = "$sha" ] || { echo "#$n moved since it was checked; run again"; exit 6; }
  gh stack merge "$n" --squash --yes || exit 6
  echo "merged #$n (lowest unmerged layer of stack $stack); GitHub retargets the next layer"
  exit 0
fi
# A rebase merge replays the commits' own messages and ignores commit_message.
if [ "$MERGE_METHOD" = rebase ] && git log --format=%B "$range" | grep -qiE "$AI_TRAILER"; then
  echo "#$n has AI trailers and a rebase merge keeps them: reword the commits first"; exit 6
fi
# Retarget stacked PRs before merging: deleting a base branch (by hand or by the repo's
# auto-delete) closes its children for good. Stop if any retarget fails.
kids=$(gh api "repos/$REPO/pulls?state=open&base=$B" --jq '.[].number')
for s in $kids; do
  got=$(gh api -X PATCH "repos/$REPO/pulls/$s" -f base="$BASE" --jq .base.ref) && [ "$got" = "$BASE" ] || { echo "retarget of #$s failed; not merging"; exit 6; }
  echo "retargeted #$s"
  gh api -X DELETE "repos/$REPO/issues/$s/labels/$STACK_LABEL" >/dev/null 2>&1 && echo "cleared $STACK_LABEL #$s"
done
title="$(gh api "repos/$REPO/pulls/$n" --jq .title) (#$n)"
msg=$(git log --reverse --format='* %s%n%n%b' "$range" | grep -viE "$AI_TRAILER" | cat -s)
gh api -X PUT "repos/$REPO/pulls/$n/merge" -f merge_method="$MERGE_METHOD" -f sha="$sha" -f commit_title="$title" -f commit_message="$msg" --jq '"merged=\(.merged) \(.sha[0:8])"' || exit 6
git push -q origin --delete "$B" 2>/dev/null && echo "deleted $B"
